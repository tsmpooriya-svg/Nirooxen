{
  "name": "nirooxen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preflight": "node scripts/preflight.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "node scripts/guard-destructive.mjs db:push && drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/guard-destructive.mjs db:seed && tsx src/db/seed.ts",
    "bootstrap:admin": "tsx scripts/create-admin.ts",
    "sms:test": "tsx scripts/send-test-sms.ts",
    "sms:report": "tsx scripts/sms-report.ts",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "db:specs": "node scripts/guard-destructive.mjs db:specs && tsx scripts/backfill-specs.mjs",
    "db:specs:dry": "tsx scripts/backfill-specs.mjs --dry-run",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:backdrops": "tsx scripts/detect-image-backdrops.ts --apply",
    "db:backdrops:dry": "tsx scripts/detect-image-backdrops.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
