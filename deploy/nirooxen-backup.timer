# =============================================================================
#  زمان‌بندی روزانهٔ پشتیبان‌گیری
# =============================================================================
#  ساعت بر اساس منطقهٔ زمانی خودِ سرور خوانده می‌شود. برای اینکه ۳ بامداد
#  واقعاً ۳ بامداد تهران باشد:
#      sudo timedatectl set-timezone Asia/Tehran
#  (این کار لاگ‌ها را هم به وقت محلی نشان می‌دهد؛ با  timedatectl  بررسی کنید.)
# =============================================================================
[Unit]
Description=پشتیبان‌گیری روزانهٔ نیروکسن

[Timer]
OnCalendar=*-*-* 03:00:00
# چند دقیقه پراکندگی، تا اگر روزی چند سرویس هم‌زمان شدند روی هم نیفتند
RandomizedDelaySec=10m
# اگر سرور موقع اجرا خاموش بوده، اولین فرصت پس از روشن شدن جبران می‌شود
Persistent=true
Unit=nirooxen-backup.service

[Install]
WantedBy=timers.target
