# =============================================================================
#  NIROOXEN — نمونه متغیرهای محیطی
# =============================================================================
#  این فایل را کپی کنید و مقادیر واقعی را جایگزین کنید:
#
#      cp .env.example .env
#
#  فایل .env هرگز نباید commit شود (در .gitignore هست).
#  هیچ مقدار واقعی، رمز یا کلیدی را در همین فایل ننویسید.
# =============================================================================


# -----------------------------------------------------------------------------
#  الزامی
# -----------------------------------------------------------------------------

# رشته اتصال PostgreSQL.
# استفاده: src/db/index.ts · drizzle.config.ts · scripts/*
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# آدرس کامل سایت، بدون اسلش انتهایی.
# مبنای canonical، Open Graph، JSON-LD، sitemap.xml و robots.txt است.
# در production الزامی است؛ اگر تعریف نشود build با خطا متوقف می‌شود تا
# آدرس localhost به‌اشتباه منتشر نشود.
# در محیط توسعه اگر خالی بماند، به http://localhost:3000 برمی‌گردد.
# استفاده: src/config/site.ts
NEXT_PUBLIC_SITE_URL="https://example.com"


# -----------------------------------------------------------------------------
#  اختیاری
# -----------------------------------------------------------------------------

# اگر پایگاه داده اتصال SSL می‌خواهد (اغلب سرویس‌های ابری)، روی true بگذارید.
# پیش‌فرض: غیرفعال.
# استفاده: src/db/index.ts
# DATABASE_SSL="true"

# بیشینه اتصال‌های همزمان در pool پایگاه داده.
# پیش‌فرض: 10
# استفاده: src/db/index.ts
# DATABASE_POOL_MAX="10"


# -----------------------------------------------------------------------------
#  ذخیره‌سازی تصاویر
# -----------------------------------------------------------------------------

# ریشه ذخیره‌سازی فایل‌های آپلودشده.
#
# در production الزامی است؛ اگر تعریف نشود برنامه هنگام اولین آپلود خطا می‌دهد
# تا تصاویر به‌اشتباه در مسیری موقت نوشته نشوند.
# در توسعه اگر خالی بماند، به یک مسیر موقت سیستم برمی‌گردد (با ری‌استارت پاک می‌شود).
#
# این مسیر باید:
#   • بیرون از پوشه پروژه باشد (src/ · public/ · .next/ · node_modules/)
#   • برای کاربر اجراکننده برنامه قابل نوشتن باشد
#   • روی فضای ذخیره‌سازی پایدار باشد و در پشتیبان‌گیری قرار بگیرد
#   • هنگام استقرار پاک یا بازساخته نشود، وگرنه تصاویر محصولات از بین می‌رود
#
# استفاده: src/lib/storage/index.ts
# MEDIA_STORAGE_ROOT="/var/lib/nirooxen/media"

# بیشینه حجم هر فایل آپلودی بر حسب مگابایت.
# پیش‌فرض: 8
# استفاده: src/lib/media/process.ts
# MEDIA_MAX_UPLOAD_MB="8"


# -----------------------------------------------------------------------------
#  یادداشت
# -----------------------------------------------------------------------------
#  NODE_ENV را خودتان تنظیم نکنید؛ next dev و next build آن را مدیریت می‌کنند.
#
#  حساب مدیر اولیه با `npm run db:seed` ساخته می‌شود و رمز پیش‌فرض دارد.
#  بلافاصله پس از نخستین ورود، از «پنل مدیریت › کاربران پنل» تغییرش دهید.
#  اسکریپت seed فقط برای محیط توسعه است.
